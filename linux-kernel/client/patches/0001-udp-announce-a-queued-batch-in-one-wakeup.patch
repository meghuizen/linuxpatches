diff --git a/kernel/sched/wait.c b/kernel/sched/wait.c
index d033f600f48c..805a24368593 100644
--- a/kernel/sched/wait.c
+++ b/kernel/sched/wait.c
@@ -194,6 +194,30 @@ void __wake_up_sync_key(struct wait_queue_head *wq_head, unsigned int mode,
 }
 EXPORT_SYMBOL_GPL(__wake_up_sync_key);
 
+/**
+ * __wake_up_sync_key_nr - wake up @nr_exclusive threads, sync variant
+ * @wq_head: the waitqueue
+ * @mode: which threads
+ * @nr_exclusive: how many exclusive waiters to wake
+ * @key: opaque value to be passed to wakeup targets
+ *
+ * __wake_up_sync_key() wakes exactly one exclusive waiter, so a caller with
+ * a batch of n independent events has to call it n times. Non-exclusive
+ * waiters -- an epoll callback, say -- then run n times to observe one
+ * change, once per call, at a spinlock and a full barrier each.
+ *
+ * This lets such a caller state the count once.
+ */
+void __wake_up_sync_key_nr(struct wait_queue_head *wq_head, unsigned int mode,
+			   int nr_exclusive, void *key)
+{
+	if (unlikely(!wq_head))
+		return;
+
+	__wake_up_common_lock(wq_head, mode, nr_exclusive, WF_SYNC, key);
+}
+EXPORT_SYMBOL_GPL(__wake_up_sync_key_nr);
+
 /**
  * __wake_up_locked_sync_key - wake up a thread blocked on a locked waitqueue.
  * @wq_head: the waitqueue
diff --git a/net/core/sock.c b/net/core/sock.c
index d23333bb4f3f..608f73952a6c 100644
--- a/net/core/sock.c
+++ b/net/core/sock.c
@@ -3656,7 +3656,7 @@ static void sock_def_error_report(struct sock *sk)
 	rcu_read_unlock();
 }
 
-void sock_def_readable(struct sock *sk)
+static void __sock_def_readable(struct sock *sk, int nr)
 {
 	struct socket_wq *wq;
 
@@ -3665,12 +3665,50 @@ void sock_def_readable(struct sock *sk)
 	rcu_read_lock();
 	wq = rcu_dereference(sk->sk_wq);
 	if (skwq_has_sleeper(wq))
-		wake_up_interruptible_sync_poll(&wq->wait, EPOLLIN | EPOLLPRI |
-						EPOLLRDNORM | EPOLLRDBAND);
+		wake_up_interruptible_sync_poll_nr(&wq->wait, nr,
+						   EPOLLIN | EPOLLPRI |
+						   EPOLLRDNORM | EPOLLRDBAND);
 	sk_wake_async_rcu(sk, SOCK_WAKE_WAITD, POLL_IN);
 	rcu_read_unlock();
 }
 
+void sock_def_readable(struct sock *sk)
+{
+	__sock_def_readable(sk, 1);
+}
+
+/**
+ * sock_data_ready_nr - announce @nr queued items in one call
+ * @sk: the socket
+ * @nr: how many independent items were queued
+ *
+ * A caller that queued a batch would otherwise call sk_data_ready() once per
+ * item, because the wakeup wakes a single exclusive waiter. Each of those
+ * calls costs a full barrier in skwq_has_sleeper(), the waitqueue lock, and
+ * one run of every non-exclusive waiter -- an epoll callback among them --
+ * which observes the same queue however many times it is invoked.
+ *
+ * This states the count once. @nr exclusive waiters are still woken, so a
+ * set of threads each blocked in their own recvmsg() see no difference.
+ *
+ * Only usable when sk_data_ready is the default. A socket whose callback has
+ * been replaced (sockmap, TLS, BPF) may count something other than waiters,
+ * so those keep the loop.
+ */
+void sock_data_ready_nr(struct sock *sk, int nr)
+{
+	void (*ready)(struct sock *sk) = READ_ONCE(sk->sk_data_ready);
+
+	if (likely(ready == sock_def_readable)) {
+		__sock_def_readable(sk, nr);
+		return;
+	}
+
+	while (nr--)
+		INDIRECT_CALL_1(ready, sock_def_readable, sk);
+}
+EXPORT_SYMBOL_GPL(sock_data_ready_nr);
+
 static void sock_def_write_space(struct sock *sk)
 {
 	struct socket_wq *wq;
