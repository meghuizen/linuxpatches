From 60b983f2c42c236b9bc0c771c2bf3ee360a3cdfd Mon Sep 17 00:00:00 2001
From: kbench <kbench@localhost>
Date: Mon, 21 Sep 2026 11:35:41 +0200
Subject: [PATCH 3/3] eventpoll: put what ep_poll_callback() touches on one
 cacheline

ep_poll_callback() runs once per file that becomes ready, from whatever
context made it ready -- softirq, for a socket. It takes ->lock, links
the epitem onto ->rdllist or ->ovflist under ->seq, and wakes ->wq.

Those five were spread over two cachelines, with ->mtx and ->poll_wait,
which the callback never touches, sitting between them:

  wait_queue_head_t wq;        /*  24  24 */   line 0
  struct list_head  rdllist;   /*  72  16 */   line 1
  spinlock_t        lock;      /*  88   4 */   line 1
  seqcount_spinlock_t seq;     /*  92   4 */   line 1
  struct epitem     *ovflist;  /* 112   8 */   line 1

so every ready file dirtied two lines and took its two locks from two
lines. A burst pays that per file, and a burst is the normal case: one
page load makes hundreds of sockets ready at once across one epoll set.

Move them together, ahead of the cold members:

  spinlock_t        lock;      /*   0   4 */   line 0
  seqcount_spinlock_t seq;     /*   4   4 */   line 0
  struct list_head  rdllist;   /*   8  16 */   line 0
  struct epitem     *ovflist;  /*  24   8 */   line 0
  wait_queue_head_t wq;        /*  32  24 */   line 0

struct eventpoll stays 200 bytes.

No functional change: this is a field reorder.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XVxrZjHzxnmyA7MDozho8A
---
 fs/eventpoll.c | 47 ++++++++++++++++++++++++++++++-----------------
 1 file changed, 30 insertions(+), 17 deletions(-)

diff --git a/fs/eventpoll.c b/fs/eventpoll.c
index e0c4bf88a838..f87f01088134 100644
--- a/fs/eventpoll.c
+++ b/fs/eventpoll.c
@@ -294,30 +294,26 @@ struct epitem {
  */
 struct eventpoll {
 	/*
-	 * This mutex is used to ensure that files are not removed
-	 * while epoll is using them. This is held during the event
-	 * collection loop, the file cleanup path, the epoll file exit
-	 * code and the ctl operations.
+	 * Everything ep_poll_callback() touches, first and together.
+	 *
+	 * That callback runs once per ready file, from whatever context made
+	 * the file ready -- softirq, for a socket. It takes ->lock, puts the
+	 * epitem on ->rdllist or ->ovflist under ->seq, and wakes ->wq. With
+	 * ->wq and the rest a cacheline apart, each call dirtied two lines
+	 * and took its two locks from two lines. A burst of ready sockets,
+	 * which is what one page load is, paid that per socket.
+	 *
+	 * Keep ->mtx, ->poll_wait and ->rbr below: none of them is on that
+	 * path.
 	 */
-	struct mutex mtx;
-
-	/* Wait queue used by sys_epoll_wait() */
-	wait_queue_head_t wq;
-
-	/* Wait queue used by file->poll() */
-	wait_queue_head_t poll_wait;
-
-	/* List of ready file descriptors */
-	struct list_head rdllist;
-
 	/* Lock which protects rdllist and ovflist */
 	spinlock_t lock;
 
 	/* Protect switching between rdllist and ovflist */
 	seqcount_spinlock_t seq;
 
-	/* RB tree root used to store monitored fd structs */
-	struct rb_root_cached rbr;
+	/* List of ready file descriptors */
+	struct list_head rdllist;
 
 	/*
 	 * This is a single linked list that chains all the "struct epitem" that
@@ -326,6 +322,23 @@ struct eventpoll {
 	 */
 	struct epitem *ovflist;
 
+	/* Wait queue used by sys_epoll_wait() */
+	wait_queue_head_t wq;
+
+	/*
+	 * This mutex is used to ensure that files are not removed
+	 * while epoll is using them. This is held during the event
+	 * collection loop, the file cleanup path, the epoll file exit
+	 * code and the ctl operations.
+	 */
+	struct mutex mtx;
+
+	/* Wait queue used by file->poll() */
+	wait_queue_head_t poll_wait;
+
+	/* RB tree root used to store monitored fd structs */
+	struct rb_root_cached rbr;
+
 	/* wakeup_source used when ep_send_events or __ep_eventpoll_poll is running */
 	struct wakeup_source *ws;
 
