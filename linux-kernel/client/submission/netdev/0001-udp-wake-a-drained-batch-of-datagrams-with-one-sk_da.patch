diff --git a/kernel/sched/wait.c b/kernel/sched/wait.c
index d033f600f48c..e06c8ac90146 100644
--- a/kernel/sched/wait.c
+++ b/kernel/sched/wait.c
@@ -194,6 +194,27 @@ void __wake_up_sync_key(struct wait_queue_head *wq_head, unsigned int mode,
 }
 EXPORT_SYMBOL_GPL(__wake_up_sync_key);
 
+/**
+ * __wake_up_sync_key_nr - sync wakeup of up to @nr_exclusive exclusive waiters
+ * @wq_head: the waitqueue
+ * @mode: which threads
+ * @nr_exclusive: how many exclusive waiters to wake
+ * @key: opaque value to be passed to wakeup targets
+ *
+ * As __wake_up_sync_key(), but for a caller that has @nr_exclusive events
+ * to announce at once: up to @nr_exclusive exclusive waiters are woken,
+ * and non-exclusive waiters are called once rather than once per event.
+ * @nr_exclusive must be positive; 0 means wake every waiter.
+ */
+void __wake_up_sync_key_nr(struct wait_queue_head *wq_head, unsigned int mode,
+			   int nr_exclusive, void *key)
+{
+	if (unlikely(!wq_head))
+		return;
+
+	__wake_up_common_lock(wq_head, mode, nr_exclusive, WF_SYNC, key);
+}
+
 /**
  * __wake_up_locked_sync_key - wake up a thread blocked on a locked waitqueue.
  * @wq_head: the waitqueue
diff --git a/net/core/sock.c b/net/core/sock.c
index d23333bb4f3f..7cad484551ca 100644
--- a/net/core/sock.c
+++ b/net/core/sock.c
@@ -3656,7 +3656,7 @@ static void sock_def_error_report(struct sock *sk)
 	rcu_read_unlock();
 }
 
-void sock_def_readable(struct sock *sk)
+static __always_inline void __sock_def_readable(struct sock *sk, int nr)
 {
 	struct socket_wq *wq;
 
@@ -3665,12 +3665,47 @@ void sock_def_readable(struct sock *sk)
 	rcu_read_lock();
 	wq = rcu_dereference(sk->sk_wq);
 	if (skwq_has_sleeper(wq))
-		wake_up_interruptible_sync_poll(&wq->wait, EPOLLIN | EPOLLPRI |
-						EPOLLRDNORM | EPOLLRDBAND);
+		wake_up_interruptible_sync_poll_nr(&wq->wait, nr,
+						   EPOLLIN | EPOLLPRI |
+						   EPOLLRDNORM | EPOLLRDBAND);
 	sk_wake_async_rcu(sk, SOCK_WAKE_WAITD, POLL_IN);
 	rcu_read_unlock();
 }
 
+void sock_def_readable(struct sock *sk)
+{
+	__sock_def_readable(sk, 1);
+}
+
+/**
+ * sock_data_ready_nr - call sk_data_ready() for @nr newly queued skbs
+ * @sk: socket
+ * @nr: number of skbs queued
+ *
+ * Equivalent to calling sk->sk_data_ready() @nr times. With the default
+ * callback the wakeup is issued once with @nr as the exclusive count, so
+ * up to @nr exclusive waiters (recvmsg()) are still woken while
+ * non-exclusive waiters (poll, epoll) are called once. A replaced callback
+ * may count calls, and O_ASYNC with an F_SETSIG signal queues one signal
+ * per call, so both keep the loop.
+ */
+void sock_data_ready_nr(struct sock *sk, int nr)
+{
+	/* nr_exclusive == 0 would wake every waiter */
+	if (unlikely(nr <= 0))
+		return;
+
+	if (likely(READ_ONCE(sk->sk_data_ready) == sock_def_readable &&
+		   !sock_flag(sk, SOCK_FASYNC))) {
+		__sock_def_readable(sk, nr);
+		return;
+	}
+
+	while (nr--)
+		INDIRECT_CALL_1(READ_ONCE(sk->sk_data_ready),
+				sock_def_readable, sk);
+}
+
 static void sock_def_write_space(struct sock *sk)
 {
 	struct socket_wq *wq;
