@@ -1752,13 +1752,9 @@ int __udp_enqueue_schedule_skb(struct sock *sk, struct sk_buff *skb)
 
 	if (!sock_flag(sk, SOCK_DEAD)) {
 		/* Multiple threads might be blocked in recvmsg(),
-		 * using prepare_to_wait_exclusive().
+		 * using prepare_to_wait_exclusive(): wake up to nb of them.
