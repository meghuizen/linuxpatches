index 60ea55dc1885..6b30ade7f0d4 100644
--- a/include/net/sock.h
+++ b/include/net/sock.h
@@ -3143,6 +3143,7 @@ static inline bool sk_dev_equal_l3scope(struct sock *sk, int dif)
 }
 
