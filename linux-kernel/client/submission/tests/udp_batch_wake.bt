#!/usr/bin/env bpftrace
/*
 * Run alongside udp_batch_wake. For each __udp_enqueue_schedule_skb()
 * call, count the sk_data_ready -> sock_def_readable() and
 * ep_poll_callback() invocations it makes before returning.
 *
 * On an unpatched kernel @ready_per_enqueue is the batch size nb (0 for
 * the calls that only llist_add() and return). With the patch, a socket
 * with the default sk_data_ready no longer calls sock_def_readable() on
 * that path (the body is inlined into sock_data_ready_nr()), so read
 * @epcb_per_enqueue instead: it should be 0 or 1, never nb.
 */
kprobe:__udp_enqueue_schedule_skb { @in[cpu] = 1; @r[cpu] = 0; @e[cpu] = 0; @enq = count(); }
kprobe:sock_def_readable /@in[cpu]/ { @r[cpu]++; }
kprobe:ep_poll_callback /@in[cpu]/ { @e[cpu]++; }
kretprobe:__udp_enqueue_schedule_skb /@in[cpu]/
{
	@ready_per_enqueue = hist(@r[cpu]);
	@epcb_per_enqueue = hist(@e[cpu]);
	@ready_total = sum(@r[cpu]);
	@epcb_total = sum(@e[cpu]);
	@in[cpu] = 0;
}
END { clear(@in); clear(@r); clear(@e); }
