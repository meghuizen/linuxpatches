From 31179d3c15b41ea8c370cf0ae41e77f4ed016635 Mon Sep 17 00:00:00 2001
From: kbench <kbench@localhost>
Date: Mon, 21 Sep 2026 10:26:46 +0200
Subject: [PATCH 8/8] netfilter: conntrack: save the raw tuple hashes for
 teardown

__nf_ct_delete_from_lists() siphashes both tuples again, purely to
derive two bucket lock indices:

	hash = hash_conntrack(net, &ct->tuplehash[ORIGINAL].tuple, ...);
	reply_hash = hash_conntrack(net, &ct->tuplehash[REPLY].tuple, ...);
	} while (nf_conntrack_double_lock(hash, reply_hash, sequence));

	clean_from_lists(ct);

The removal itself does not need them: clean_from_lists() calls
hlist_nulls_del_rcu(), which unlinks through the node's own pprev and
never looks at the bucket head. The hashes only select
nf_conntrack_locks[], so that the delete serialises against inserts and
lookups on the same two buckets.

Those are the same two values __nf_conntrack_confirm() already computed.
Save them in nf_conn and scale them again at teardown.

Raw and not scaled, deliberately. scale_hash() depends on
nf_conntrack_htable_size, which a resize changes, so the scaling must be
redone at each use and the nf_conntrack_generation seqcount retry still
covers a resize racing with us. The raw value cannot go stale: the
tuples are fixed once confirmed, zone and netns are fixed for the
lifetime, and nf_conntrack_hash_rnd is get_random_once().

Taking both raw hashes outside confirm's retry loop also stops the reply
tuple being rehashed on every retry, since only the scaling depends on
what the seqcount guards.

nf_conn grows from 248 to 256 bytes, and the slab object does not grow at
all: nf_conntrack_cachep has SLAB_HWCACHE_ALIGN, which already rounded
248 up to 256. Checked with every NF_CONNTRACK option enabled as well.
There is no new allocation, so nothing to leak.

Only a confirmed entry is ever on the lists -- clean_from_lists() already
depends on that -- so the saved values are always valid where they are
read. A WARN_ON_ONCE() states the invariant rather than leaving it to be
rediscovered.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XVxrZjHzxnmyA7MDozho8A
---
 include/net/netfilter/nf_conntrack.h | 15 +++++++++++
 net/netfilter/nf_conntrack_core.c    | 38 ++++++++++++++++++----------
 2 files changed, 40 insertions(+), 13 deletions(-)

diff --git a/include/net/netfilter/nf_conntrack.h b/include/net/netfilter/nf_conntrack.h
index bc42dd0e10e6..bdce5bb0ecb0 100644
--- a/include/net/netfilter/nf_conntrack.h
+++ b/include/net/netfilter/nf_conntrack.h
@@ -88,6 +88,21 @@ struct nf_conn {
 	/* jiffies32 when this ct is considered dead */
 	u32 timeout;
 
+	/* Raw, unscaled hash of each direction's tuple, saved by
+	 * __nf_conntrack_confirm() so that teardown does not have to siphash
+	 * both tuples again purely to work out which bucket locks to take.
+	 *
+	 * Raw and not scaled on purpose: scale_hash() depends on
+	 * nf_conntrack_htable_size, which a resize changes under us, so the
+	 * scaling has to be redone at every use. The raw value does not
+	 * change -- the tuples are fixed once confirmed, the zone and netns
+	 * are fixed for the lifetime, and nf_conntrack_hash_rnd is
+	 * get_random_once().
+	 *
+	 * Only valid once IPS_CONFIRMED is set.
+	 */
+	u32 hash_raw[IP_CT_DIR_MAX];
+
 #ifdef CONFIG_NF_CONNTRACK_ZONES
 	struct nf_conntrack_zone zone;
 #endif
diff --git a/net/netfilter/nf_conntrack_core.c b/net/netfilter/nf_conntrack_core.c
index f0c84372101f..aca315525b52 100644
--- a/net/netfilter/nf_conntrack_core.c
+++ b/net/netfilter/nf_conntrack_core.c
@@ -647,18 +647,20 @@ EXPORT_SYMBOL(nf_ct_destroy);
 
 static void __nf_ct_delete_from_lists(struct nf_conn *ct)
 {
-	struct net *net = nf_ct_net(ct);
 	unsigned int hash, reply_hash;
 	unsigned int sequence;
 
+	/* Only a confirmed entry is on the lists, and clean_from_lists()
+	 * below already depends on that: it unlinks both hnnodes. The saved
+	 * hashes are written by __nf_conntrack_confirm(), so the same
+	 * invariant makes them valid here.
+	 */
+	WARN_ON_ONCE(!nf_ct_is_confirmed(ct));
+
 	do {
 		sequence = read_seqcount_begin(&nf_conntrack_generation);
-		hash = hash_conntrack(net,
-				      &ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple,
-				      nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_ORIGINAL));
-		reply_hash = hash_conntrack(net,
-					   &ct->tuplehash[IP_CT_DIR_REPLY].tuple,
-					   nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_REPLY));
+		hash = scale_hash(ct->hash_raw[IP_CT_DIR_ORIGINAL]);
+		reply_hash = scale_hash(ct->hash_raw[IP_CT_DIR_REPLY]);
 	} while (nf_conntrack_double_lock(hash, reply_hash, sequence));
 
 	clean_from_lists(ct);
@@ -1230,14 +1232,24 @@ __nf_conntrack_confirm(struct sk_buff *skb)
 	zone = nf_ct_zone(ct);
 	local_bh_disable();
 
+	/* Take both raw hashes once, outside the retry loop: only the scaling
+	 * depends on the table size that the seqcount is guarding, so a retry
+	 * does not need the siphashes again. The original direction's value
+	 * was stashed in the reply hnnode's pprev before confirmation; keep
+	 * it, because that slot becomes a real list pointer below and the
+	 * value is wanted again at teardown.
+	 */
+	ct->hash_raw[IP_CT_DIR_ORIGINAL] =
+		*(unsigned long *)&ct->tuplehash[IP_CT_DIR_REPLY].hnnode.pprev;
+	ct->hash_raw[IP_CT_DIR_REPLY] =
+		hash_conntrack_raw(&ct->tuplehash[IP_CT_DIR_REPLY].tuple,
+				   nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_REPLY),
+				   net);
+
 	do {
 		sequence = read_seqcount_begin(&nf_conntrack_generation);
-		/* reuse the hash saved before */
-		hash = *(unsigned long *)&ct->tuplehash[IP_CT_DIR_REPLY].hnnode.pprev;
-		hash = scale_hash(hash);
-		reply_hash = hash_conntrack(net,
-					   &ct->tuplehash[IP_CT_DIR_REPLY].tuple,
-					   nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_REPLY));
+		hash = scale_hash(ct->hash_raw[IP_CT_DIR_ORIGINAL]);
+		reply_hash = scale_hash(ct->hash_raw[IP_CT_DIR_REPLY]);
 	} while (nf_conntrack_double_lock(hash, reply_hash, sequence));
 
 	/* We're not in hash table, and we refuse to set up related
