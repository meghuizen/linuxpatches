From ee5aae8d6498899e091b4b039e53c8768f8657c0 Mon Sep 17 00:00:00 2001
From: Michiel <367462+meghuizen@users.noreply.github.com>
Date: Wed, 23 Sep 2026 10:34:02 +0200
Subject: [RFC PATCH net-next 2/2] net: bridge: skip the ARP proxy path when no
 port uses it

br_handle_frame_finish() calls br_do_proxy_suppress_arp() for every ARP
and RARP frame.  With neither neighbour suppression nor proxy ARP on any
port, the function still pulls and parses the ARP header and, for a
request, calls neigh_lookup() for the target and br_fdb_find_rcu() for
its address, and then changes nothing: proxyarp_replied and grat_arp
are only set under BROPT_NEIGH_SUPPRESS_ENABLED, BR_PROXYARP on the
ingress port, BR_PROXYARP_WIFI on the destination port, or neighbour
suppression on the destination port.  The ND branch next to it is
already gated on BROPT_NEIGH_SUPPRESS_ENABLED.

Add BROPT_PROXYARP_ENABLED, computed in
br_recalculate_neigh_suppress_enabled() with
BROPT_NEIGH_SUPPRESS_ENABLED, recalculate it when BR_PROXYARP or
BR_PROXYARP_WIFI changes, and return early when neither option is set.
Like BROPT_NEIGH_SUPPRESS_ENABLED, it is not recalculated when a port
is removed, so it can stay set after the last proxy ARP port is gone;
that only disables the early return.

Not measured.

Generated code: br_do_proxy_suppress_arp() gains a 5-instruction early
return (301 -> 306 instructions); br_recalculate_neigh_suppress_enabled(),
which runs only when port flags change, grows from 41 to 66.

Tested: br_arp_nd_proxy.o, br_if.o and br_input.o build without
warnings (W=1) on x86_64.

Assisted-by: Claude
---
Impact: low -- bridges without proxy_arp or neigh_suppress ports,
per received ARP frame.  Not measured; an AF_PACKET ARP frame generator
for the measurement is written but has not been run.

 net/bridge/br_arp_nd_proxy.c | 17 +++++++++++++++--
 net/bridge/br_if.c           |  3 ++-
 net/bridge/br_private.h      |  1 +
 3 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/net/bridge/br_arp_nd_proxy.c b/net/bridge/br_arp_nd_proxy.c
index 87a40e2f1c50..331064bb777c 100644
--- a/net/bridge/br_arp_nd_proxy.c
+++ b/net/bridge/br_arp_nd_proxy.c
@@ -28,15 +28,23 @@ void br_recalculate_neigh_suppress_enabled(struct net_bridge *br)
 {
 	struct net_bridge_port *p;
 	bool neigh_suppress = false;
+	bool proxyarp = false;
 
 	list_for_each_entry(p, &br->port_list, list) {
-		if (READ_ONCE(p->flags) & (BR_NEIGH_SUPPRESS | BR_NEIGH_VLAN_SUPPRESS)) {
+		unsigned long flags = READ_ONCE(p->flags);
+
+		if (flags & (BR_NEIGH_SUPPRESS | BR_NEIGH_VLAN_SUPPRESS))
 			neigh_suppress = true;
+
+		if (flags & (BR_PROXYARP | BR_PROXYARP_WIFI))
+			proxyarp = true;
+
+		if (neigh_suppress && proxyarp)
 			break;
-		}
 	}
 
 	br_opt_toggle(br, BROPT_NEIGH_SUPPRESS_ENABLED, neigh_suppress);
+	br_opt_toggle(br, BROPT_PROXYARP_ENABLED, proxyarp);
 }
 
 #if IS_ENABLED(CONFIG_INET)
@@ -135,6 +143,11 @@ void br_do_proxy_suppress_arp(struct sk_buff *skb, struct net_bridge *br,
 	BR_INPUT_SKB_CB(skb)->proxyarp_replied = 0;
 	BR_INPUT_SKB_CB(skb)->grat_arp = 0;
 
+	/* Every reply and suppression below needs one of these. */
+	if (!br_opt_get(br, BROPT_NEIGH_SUPPRESS_ENABLED) &&
+	    !br_opt_get(br, BROPT_PROXYARP_ENABLED))
+		return;
+
 	if ((dev->flags & IFF_NOARP) ||
 	    !pskb_may_pull(skb, arp_hdr_len(dev)))
 		return;
diff --git a/net/bridge/br_if.c b/net/bridge/br_if.c
index c52613431f88..b234d430acd3 100644
--- a/net/bridge/br_if.c
+++ b/net/bridge/br_if.c
@@ -752,7 +752,8 @@ void br_port_flags_change(struct net_bridge_port *p, unsigned long mask)
 	if (mask & BR_AUTO_MASK)
 		nbp_update_port_count(br);
 
-	if (mask & (BR_NEIGH_SUPPRESS | BR_NEIGH_VLAN_SUPPRESS))
+	if (mask & (BR_NEIGH_SUPPRESS | BR_NEIGH_VLAN_SUPPRESS |
+		    BR_PROXYARP | BR_PROXYARP_WIFI))
 		br_recalculate_neigh_suppress_enabled(br);
 }
 
diff --git a/net/bridge/br_private.h b/net/bridge/br_private.h
index b01997ea9508..c697347e1f71 100644
--- a/net/bridge/br_private.h
+++ b/net/bridge/br_private.h
@@ -487,6 +487,7 @@ enum net_bridge_opts {
 	BROPT_MULTICAST_STATS_ENABLED,
 	BROPT_HAS_IPV6_ADDR,
 	BROPT_NEIGH_SUPPRESS_ENABLED,
+	BROPT_PROXYARP_ENABLED,
 	BROPT_MTU_SET_BY_USER,
 	BROPT_VLAN_STATS_PER_PORT,
 	BROPT_NO_LL_LEARN,
-- 
