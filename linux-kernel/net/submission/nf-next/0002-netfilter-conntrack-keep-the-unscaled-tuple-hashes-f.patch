From dcc6d07666c93ce110ac24c6bb866d195d017303 Mon Sep 17 00:00:00 2001
From: Michiel <367462+meghuizen@users.noreply.github.com>
Date: Wed, 23 Sep 2026 10:27:46 +0200
Subject: [PATCH nf-next 2/3] netfilter: conntrack: keep the unscaled tuple
 hashes for teardown

__nf_ct_delete_from_lists() hashes both tuples again only to pick the
two bucket locks for nf_conntrack_double_lock(); the unlink itself goes
through the nodes' pprev.  Both hashes were already computed when the
entry was inserted.

Store the unscaled hashes in struct nf_conn at insertion, in
__nf_conntrack_confirm() and nf_conntrack_hash_check_insert(), and
scale them at teardown.  They are kept unscaled because a resize changes
nf_conntrack_htable_size; the nf_conntrack_generation retry loop still
covers a resize racing with the delete.  The unscaled value does not
change: the tuples are fixed once inserted, and so are the zone, the
netns and nf_conntrack_hash_rnd.

This removes two hash_conntrack_raw() calls per deleted entry: two
siphash_2u64() calls for IPv4 with the previous patch, 164 instructions
each on x86_64 (same userspace perf measurement as the previous patch),
or two 39-byte siphash() calls, 256 each, for IPv6.  It adds two stores
at insertion.  objdump confirms __nf_ct_delete_from_lists() no longer
calls hash_conntrack_raw().

struct nf_conn grows from 248 to 256 bytes on x86_64 with ZONES, MARK,
SECMARK and NAT enabled, and from 196 to 204 bytes on an i386 defconfig
with conntrack (pahole).  The slab object does not grow in either case:
nf_conntrack_cachep uses SLAB_HWCACHE_ALIGN, which already rounded
them to 256 and 224 bytes.

In the built kernel __nf_ct_delete_from_lists() no longer calls
hash_conntrack_raw() (two calls before).
nf_conntrack_hash_check_insert() still hashes, and now also stores
hash_raw[].

Runtime, same guest and boots as patch 1: flushing a table of 60000
entries with conntrack -F costs 1908 kernel instructions per entry on
the base kernel (median of 7 boots, 1908-1939) and 1311 with patches 1-3
(1311.3 and 1311.7, 2 boots): -597 per entry.  Without patch 1 each
removed hash_conntrack_raw() call is a 39-byte siphash() plus the call,
about 300 instructions, so this is the two removed calls.

A ctnetlink insert of 64 entries, a table resize, and a delete of all
64 left no entries behind; three resizes during flow churn kept the
entry count and the dump consistent (60000 each).  No kernel warnings.

Tested: nf_conntrack_core.o and nf_conntrack_netlink.o build without
warnings (W=1) on x86_64, nf_conntrack_core.o on i386; the runtime run
above.

Assisted-by: Claude pahole perf
---
Impact: low -- conntrack entry deletion (timeout, early_drop, flush):
two hash computations saved per deleted entry, -597 instructions
per entry measured in a guest (-31%).  No wall-clock measurement.

- Layout: on x86_64 tuplehash[] moves from 16 to 24; the reply tuple
  now ends at 136 and shares cache line 2 with status and ct_net, which
  lookups read anyway, so a lookup touches the same three lines in
  either direction.
- A configuration where sizeof(struct nf_conn) is already a multiple of
  the cache line size would grow by one line; the two configurations
  checked (x86_64 with every conntrack option, i386 defconfig) do not.
- nf_conntrack_hash_check_insert() (ctnetlink, bpf) must set the hashes
  too; entries on the lists that skipped it would take the wrong bucket
  locks at deletion.
- Builds and is correct without patch 1; only the IPv4 figure quoted
  assumes it.

 include/net/netfilter/nf_conntrack.h |  6 ++++
 net/netfilter/nf_conntrack_core.c    | 51 ++++++++++++++--------------
 2 files changed, 31 insertions(+), 26 deletions(-)

diff --git a/include/net/netfilter/nf_conntrack.h b/include/net/netfilter/nf_conntrack.h
index bc42dd0e10e6..3a9752bbecbc 100644
--- a/include/net/netfilter/nf_conntrack.h
+++ b/include/net/netfilter/nf_conntrack.h
@@ -88,6 +88,12 @@ struct nf_conn {
 	/* jiffies32 when this ct is considered dead */
 	u32 timeout;
 
+	/* Unscaled tuple hashes, set when the entry is inserted into the
+	 * hash table.  Kept unscaled because a table resize changes the
+	 * scaling.
+	 */
+	u32 hash_raw[IP_CT_DIR_MAX];
+
 #ifdef CONFIG_NF_CONNTRACK_ZONES
 	struct nf_conntrack_zone zone;
 #endif
diff --git a/net/netfilter/nf_conntrack_core.c b/net/netfilter/nf_conntrack_core.c
index 24b3f2b58227..14072c186d2c 100644
--- a/net/netfilter/nf_conntrack_core.c
+++ b/net/netfilter/nf_conntrack_core.c
@@ -250,13 +250,6 @@ static u32 __hash_conntrack(const struct net *net,
 	return reciprocal_scale(hash_conntrack_raw(tuple, zoneid, net), size);
 }
 
-static u32 hash_conntrack(const struct net *net,
-			  const struct nf_conntrack_tuple *tuple,
-			  unsigned int zoneid)
-{
-	return scale_hash(hash_conntrack_raw(tuple, zoneid, net));
-}
-
 static bool nf_ct_get_tuple_ports(const struct sk_buff *skb,
 				  unsigned int dataoff,
 				  struct nf_conntrack_tuple *tuple)
@@ -631,18 +624,13 @@ EXPORT_SYMBOL(nf_ct_destroy);
 
 static void __nf_ct_delete_from_lists(struct nf_conn *ct)
 {
-	struct net *net = nf_ct_net(ct);
 	unsigned int hash, reply_hash;
 	unsigned int sequence;
 
 	do {
 		sequence = read_seqcount_begin(&nf_conntrack_generation);
-		hash = hash_conntrack(net,
-				      &ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple,
-				      nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_ORIGINAL));
-		reply_hash = hash_conntrack(net,
-					   &ct->tuplehash[IP_CT_DIR_REPLY].tuple,
-					   nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_REPLY));
+		hash = scale_hash(ct->hash_raw[IP_CT_DIR_ORIGINAL]);
+		reply_hash = scale_hash(ct->hash_raw[IP_CT_DIR_REPLY]);
 	} while (nf_conntrack_double_lock(hash, reply_hash, sequence));
 
 	clean_from_lists(ct);
@@ -881,15 +869,20 @@ nf_conntrack_hash_check_insert(struct nf_conn *ct)
 
 	zone = nf_ct_zone(ct);
 
+	ct->hash_raw[IP_CT_DIR_ORIGINAL] =
+		hash_conntrack_raw(&ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple,
+				   nf_ct_zone_id(zone, IP_CT_DIR_ORIGINAL),
+				   net);
+	ct->hash_raw[IP_CT_DIR_REPLY] =
+		hash_conntrack_raw(&ct->tuplehash[IP_CT_DIR_REPLY].tuple,
+				   nf_ct_zone_id(zone, IP_CT_DIR_REPLY),
+				   net);
+
 	local_bh_disable();
 	do {
 		sequence = read_seqcount_begin(&nf_conntrack_generation);
-		hash = hash_conntrack(net,
-				      &ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple,
-				      nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_ORIGINAL));
-		reply_hash = hash_conntrack(net,
-					   &ct->tuplehash[IP_CT_DIR_REPLY].tuple,
-					   nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_REPLY));
+		hash = scale_hash(ct->hash_raw[IP_CT_DIR_ORIGINAL]);
+		reply_hash = scale_hash(ct->hash_raw[IP_CT_DIR_REPLY]);
 	} while (nf_conntrack_double_lock(hash, reply_hash, sequence));
 
 	max_chainlen = MIN_CHAINLEN + get_random_u32_below(MAX_CHAINLEN);
@@ -1214,14 +1207,20 @@ __nf_conntrack_confirm(struct sk_buff *skb)
 	zone = nf_ct_zone(ct);
 	local_bh_disable();
 
+	/* The original direction's hash was stashed in the reply hnnode's
+	 * pprev by init_conntrack(); that slot is overwritten on insertion.
+	 */
+	ct->hash_raw[IP_CT_DIR_ORIGINAL] =
+		*(unsigned long *)&ct->tuplehash[IP_CT_DIR_REPLY].hnnode.pprev;
+	ct->hash_raw[IP_CT_DIR_REPLY] =
+		hash_conntrack_raw(&ct->tuplehash[IP_CT_DIR_REPLY].tuple,
+				   nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_REPLY),
+				   net);
+
 	do {
 		sequence = read_seqcount_begin(&nf_conntrack_generation);
-		/* reuse the hash saved before */
-		hash = *(unsigned long *)&ct->tuplehash[IP_CT_DIR_REPLY].hnnode.pprev;
-		hash = scale_hash(hash);
-		reply_hash = hash_conntrack(net,
-					   &ct->tuplehash[IP_CT_DIR_REPLY].tuple,
-					   nf_ct_zone_id(nf_ct_zone(ct), IP_CT_DIR_REPLY));
+		hash = scale_hash(ct->hash_raw[IP_CT_DIR_ORIGINAL]);
+		reply_hash = scale_hash(ct->hash_raw[IP_CT_DIR_REPLY]);
 	} while (nf_conntrack_double_lock(hash, reply_hash, sequence));
 
 	/* We're not in hash table, and we refuse to set up related
