From 0bcd545a232b296ce8e88d0ac855c5309585b2e8 Mon Sep 17 00:00:00 2001
From: kbench <kbench@localhost>
Date: Mon, 21 Sep 2026 09:27:49 +0200
Subject: [PATCH 2/2] sched: group the EEVDF fields of sched_entity onto one
 cacheline

run_node, deadline, vruntime, min_vruntime, vlag and slice are what
pick_eevdf() compares. They were spread over three cachelines on x86_64
and two on i386, so an O(log n) descent touched that many lines per
level. Placing them first puts them on one line on both: they are
exactly 64 bytes on 64-bit, and 52 on 32-bit where rb_node is smaller.

update_curr()'s fields follow on the second line; the hierarchy
pointers, slice bounds, nr_migrations, group_node and h_load on the
third. h_load was on the pick line on both architectures, and the load
balancer writes it from a remote CPU.

avg keeps its alignment and its own line for PELT. sched_entity does not
grow, so no offset after se moves and task_struct is untouched.

No functional change: nothing takes offsetof() on sched_entity, nothing
memsets a subrange, and the rbtree reaches run_node through rb_entry().

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XVxrZjHzxnmyA7MDozho8A
---
 include/linux/sched.h | 61 +++++++++++++++++++++++++++++--------------
 1 file changed, 41 insertions(+), 20 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index c27b6cd994fb..70bd0e51895e 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -570,44 +570,65 @@ struct sched_statistics {
 } ____cacheline_aligned;
 
 struct sched_entity {
-	/* For load-balancing: */
-	struct load_weight		load;
-	struct load_weight		h_load;
+	/*
+	 * First cacheline: everything the EEVDF pick and the rbtree walk
+	 * read. pick_eevdf() and entity_before() compare deadline and
+	 * vruntime against min_vruntime while walking run_node, and
+	 * update_entity_lag() needs vlag and slice. Before this grouping
+	 * those six were spread over se+0, se+64 and se+128, so one pick
+	 * touched three lines of every entity it examined; the walk is
+	 * O(log n) entities deep, so it was three lines per level.
+	 *
+	 * These six are exactly 64 bytes, and sched_entity is itself
+	 * 64-byte aligned, so they occupy one line with nothing else in it.
+	 */
 	struct rb_node			run_node;
 	u64				deadline;
+	u64				vruntime;
 	u64				min_vruntime;
-	u64				min_slice;
-	u64				max_slice;
-
-	struct list_head		group_node;
-	unsigned char			on_rq;
-	unsigned char			sched_delayed;
-	unsigned char			rel_deadline;
-	unsigned char			custom_slice;
-					/* hole */
+	/* Approximated virtual lag: */
+	s64				vlag;
+	u64				slice;
 
+	/*
+	 * Second cacheline: update_curr() and the enqueue/dequeue flags.
+	 * Written when the entity runs rather than when it is searched for,
+	 * so they are kept off the line above.
+	 */
+	struct load_weight		load;
 	u64				exec_start;
 	u64				sum_exec_runtime;
 	u64				prev_sum_exec_runtime;
-	u64				vruntime;
-	/* Approximated virtual lag: */
-	s64				vlag;
 	/* 'Protected' deadline, to give out minimum quantums: */
 	u64				vprot;
-	u64				slice;
-
-	u64				nr_migrations;
-
+	unsigned char			on_rq;
+	unsigned char			sched_delayed;
+	unsigned char			rel_deadline;
+	unsigned char			custom_slice;
 #ifdef CONFIG_FAIR_GROUP_SCHED
 	int				depth;
-	struct sched_entity		*parent;
 	/* rq on which this entity is (to be) queued: */
 	struct cfs_rq			*cfs_rq;
+#endif
+
+	/*
+	 * Third cacheline onwards: the hierarchy walk, load balancing and
+	 * counters. Read on paths that are already walking pointers or
+	 * already off the fast path.
+	 */
+#ifdef CONFIG_FAIR_GROUP_SCHED
+	struct sched_entity		*parent;
 	/* rq "owned" by this entity/group: */
 	struct cfs_rq			*my_q;
 	/* cached value of my_q->h_nr_running */
 	unsigned long			runnable_weight;
 #endif
+	u64				min_slice;
+	u64				max_slice;
+	u64				nr_migrations;
+	struct list_head		group_node;
+	/* For load-balancing: */
+	struct load_weight		h_load;
 
 	/*
 	 * Per entity load average tracking.
