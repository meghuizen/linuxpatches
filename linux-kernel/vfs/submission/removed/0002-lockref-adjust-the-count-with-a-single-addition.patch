From ffcd8df3551be580ac0044debf606cb0f44626c3 Mon Sep 17 00:00:00 2001
From: Michiel <367462+meghuizen@users.noreply.github.com>
Date: Sun, 20 Sep 2026 13:29:23 +0200
Subject: [RFC PATCH 2/4] lockref: adjust the count with a single addition

The cmpxchg fast paths in lib/lockref.c work on a copy of the 64-bit
lock_count word but update it with new.count++ or new.count--. gcc
then extracts the 32-bit count, adjusts it and reassembles the word
before the cmpxchg. On x86-64 (gcc 15.2) lockref_get() does:

  before                         after
    mov    %rdx,%rcx               movabs $0x100000000,%rdx
    mov    %edx,%edx               add    %rax,%rdx
    sar    $0x20,%rcx
    add    $0x1,%ecx
    shl    $0x20,%rcx
    or     %rcx,%rdx
    lock cmpxchg %rdx,(%rdi)       lock cmpxchg %rdx,(%rdi)

Add or subtract the count's unit to the whole word instead. The unit is
taken from the struct layout through a union, so it is 1 << 32 on
little-endian and 1 on big-endian. The result is the same as adjusting
the count alone except when the count half would wrap into the lock
half, which needs a count of -1 on increment or 0 on decrement on
big-endian: the decrementing variants return before updating a count
<= 0, and lockref_get() requires a held reference, so its count is
never -1 (a dead lockref is -128). The lock half is zero in the loop.

Instructions per function in the built kernel (x86-64, gcc 15.2, by
symbol size):

  lockref_get           27 -> 19
  lockref_get_not_zero  42 -> 36
  lockref_get_not_dead  42 -> 36
  lockref_put_or_lock   37 -> 31
  lockref_put_return    24 -> 21

A userspace copy of the loop (single thread, uncontended, AMD Ryzen 9
8940HX, perf stat, 5 x 5*10^7 get+put pairs, runs interleaved) goes
from 58.0 to 51.0 instructions and from 29.8 to 28.4 cycles (medians)
per pair. There is no in-kernel measurement of this patch alone.

Built lib/lockref.o (x86-64). The userspace copy checks, for
little-endian, that both forms give the same word for counts around
-128, -1, 0, 1 and INT_MAX. Big-endian was not built.

Assisted-by: Claude perf
---
Impact: low -- a few instructions per dentry reference get/put on
every path lookup; not measurable in the kernel against boot-to-boot
noise on the test machine.

The userspace model and its results are available on request (a copy of
CMPXCHG_LOOP with both update forms, run under perf stat). Architectures
other than x86-64 were not compiled; on big-endian the unit is 1 and the
wrap argument in the changelog applies.

 lib/lockref.c | 27 ++++++++++++++++++++++-----
 1 file changed, 22 insertions(+), 5 deletions(-)

diff --git a/lib/lockref.c b/lib/lockref.c
index 9b3dd688d8cd..e3f772ac0751 100644
--- a/lib/lockref.c
+++ b/lib/lockref.c
@@ -4,6 +4,23 @@
 
 #if USE_CMPXCHG_LOCKREF
 
+/*
+ * The unit of the count within the 64-bit lock_count word: 1 << 32 on
+ * little-endian, 1 on big-endian. Adding it to the whole word avoids
+ * extracting and re-inserting the 32-bit count. The lock half is zero
+ * whenever the update is made, and the conditional variants return before
+ * a decrement from 0; lockref_get() is never called on a count of -1.
+ */
+static __always_inline u64 lockref_step(void)
+{
+	const union {
+		struct lockref lr;
+		u64 v;
+	} one = { .lr = { .count = 1 } };
+
+	return one.v;
+}
+
 /*
  * Note that the "cmpxchg()" reloads the "old" value for the
  * failure case.
@@ -42,7 +59,7 @@
 void lockref_get(struct lockref *lockref)
 {
 	CMPXCHG_LOOP(
-		new.count++;
+		new.lock_count += lockref_step();
 	,
 		return;
 	);
@@ -63,7 +80,7 @@ bool lockref_get_not_zero(struct lockref *lockref)
 	bool retval = false;
 
 	CMPXCHG_LOOP(
-		new.count++;
+		new.lock_count += lockref_step();
 		if (old.count <= 0)
 			return false;
 	,
@@ -90,7 +107,7 @@ EXPORT_SYMBOL(lockref_get_not_zero);
 int lockref_put_return(struct lockref *lockref)
 {
 	CMPXCHG_LOOP(
-		new.count--;
+		new.lock_count -= lockref_step();
 		if (old.count <= 0)
 			return -1;
 	,
@@ -108,7 +125,7 @@ EXPORT_SYMBOL(lockref_put_return);
 bool lockref_put_or_lock(struct lockref *lockref)
 {
 	CMPXCHG_LOOP(
-		new.count--;
+		new.lock_count -= lockref_step();
 		if (old.count <= 1)
 			break;
 	,
@@ -145,7 +162,7 @@ bool lockref_get_not_dead(struct lockref *lockref)
 	bool retval = false;
 
 	CMPXCHG_LOOP(
-		new.count++;
+		new.lock_count += lockref_step();
 		if (old.count < 0)
 			return false;
 	,
-- 
