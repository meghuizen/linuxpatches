From 45c2ce51e90e6269af0fd98a23118844da48707f Mon Sep 17 00:00:00 2001
From: Michiel <367462+meghuizen@users.noreply.github.com>
Date: Sun, 20 Sep 2026 13:26:13 +0200
Subject: [PATCH 06/14] ext4: let stat() run ->getattr in rcu-walk

Set IOP_GETATTR_RCU on every ext4 inode, in the two places all of them
pass through: __ext4_iget() for inodes read from disk and
__ext4_new_inode() for new ones.

ext4_getattr() reads ext4_inode_info and the inode - i_crtime,
i_flags, the DIO alignment and atomic write limits from the superblock
info and the block device's queue limits - and calls generic_fillattr().
ext4_file_getattr() adds the delayed-allocation reservation from
ei->i_reserved_data_blocks, a plain read. None of it sleeps, takes a
reference, or writes anything but the kstat, so both qualify as they
are.

ext4_encrypted_symlink_getattr() is the exception: fscrypt_symlink_getattr()
reports the length of the target as userspace will see it, and if the
target is not cached in ->i_link yet that means reading the symlink
block. It now returns -ECHILD when called with AT_GETATTR_RCU and no
cached target, and the VFS retries with references as before. Once the
target has been read once it is cached and later stats stay in
rcu-walk.

The inode handed to ->getattr in this mode may be mid-eviction; the
fields read here are all within the ext4_inode_info, which is freed
through RCU with the inode, and the superblock, which the mount pins.
---
 fs/ext4/ialloc.c  |  2 ++
 fs/ext4/inode.c   |  6 ++++++
 fs/ext4/symlink.c | 10 ++++++++++
 3 files changed, 18 insertions(+)

diff --git a/fs/ext4/ialloc.c b/fs/ext4/ialloc.c
index a5831fc536db..966548811a20 100644
--- a/fs/ext4/ialloc.c
+++ b/fs/ext4/ialloc.c
@@ -1277,6 +1277,8 @@ struct inode *__ext4_new_inode(struct mnt_idmap *idmap,
 	ei->i_last_alloc_group = ~0;
 
 	ext4_set_inode_flags(inode, true);
+	/* see __ext4_iget() */
+	inode->i_opflags |= IOP_GETATTR_RCU;
 	if (IS_DIRSYNC(inode))
 		ext4_handle_sync(handle);
 	if (insert_inode_locked(inode) < 0) {
diff --git a/fs/ext4/inode.c b/fs/ext4/inode.c
index 26f0f9714f03..aa0f3d4e95f6 100644
--- a/fs/ext4/inode.c
+++ b/fs/ext4/inode.c
@@ -5672,6 +5672,12 @@ struct inode *__ext4_iget(struct super_block *sb, unsigned long ino,
 		goto bad_inode;
 	}
 
+	/*
+	 * Every ext4 ->getattr only reads the inode; the one that may not,
+	 * ext4_encrypted_symlink_getattr(), checks AT_GETATTR_RCU itself.
+	 */
+	inode->i_opflags |= IOP_GETATTR_RCU;
+
 	ext4_set_inode_mapping_order(inode);
 
 	ret = check_igot_inode(inode, flags, function, line);
diff --git a/fs/ext4/symlink.c b/fs/ext4/symlink.c
index b612262719ed..ee9aed1d2ad0 100644
--- a/fs/ext4/symlink.c
+++ b/fs/ext4/symlink.c
@@ -60,6 +60,16 @@ static int ext4_encrypted_symlink_getattr(struct mnt_idmap *idmap,
 					  struct kstat *stat, u32 request_mask,
 					  unsigned int query_flags)
 {
+	/*
+	 * fscrypt_symlink_getattr() reports the length of the target as
+	 * userspace will see it, which means reading the target if it is not
+	 * cached in ->i_link yet - and that reads a block. In rcu-walk that
+	 * has to be left to the retry with references.
+	 */
+	if ((query_flags & AT_GETATTR_RCU) &&
+	    !READ_ONCE(d_inode(path->dentry)->i_link))
+		return -ECHILD;
+
 	ext4_getattr(idmap, path, stat, request_mask, query_flags);
 
 	return fscrypt_symlink_getattr(path, stat);
-- 
2.53.0

