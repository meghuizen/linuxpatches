From 1087f26010d12447a4d514d16d82d69a7d87b9c5 Mon Sep 17 00:00:00 2001
From: Michiel <michieleghuizen@gmail.com>
Date: Sun, 20 Sep 2026 13:29:23 +0200
Subject: [PATCH 10/14] selftests: point the openat2 target at where the tests
 actually live

tools/testing/selftests/Makefile lists "openat2" in TARGETS, but there
is no tools/testing/selftests/openat2 directory: the tests moved to
filesystems/openat2 and that directory is not in TARGETS, nor is it
built by filesystems/Makefile. So the four binaries covering the whole
RESOLVE_* surface - openat2_test, resolve_test, rename_attack_test and
emptypath_test - are never built or run by "make kselftest", and the
dangling entry produces a "no such directory" warning instead.

Replace the stale entry with filesystems/openat2, next to the other
filesystems/ targets.
---
 tools/testing/selftests/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/testing/selftests/Makefile b/tools/testing/selftests/Makefile
index 2d960626750e..d6ed25cbf7f7 100644
--- a/tools/testing/selftests/Makefile
+++ b/tools/testing/selftests/Makefile
@@ -37,6 +37,7 @@ TARGETS += filesystems/binderfs
 TARGETS += filesystems/epoll
 TARGETS += filesystems/failfs
 TARGETS += filesystems/fat
+TARGETS += filesystems/openat2
 TARGETS += filesystems/overlayfs
 TARGETS += filesystems/statmount
 TARGETS += filesystems/mount-notify
@@ -103,7 +104,6 @@ TARGETS += prctl
 TARGETS += proc
 TARGETS += pstore
 TARGETS += ptrace
-TARGETS += openat2
 TARGETS += rdma
 TARGETS += resctrl
 TARGETS += riscv
