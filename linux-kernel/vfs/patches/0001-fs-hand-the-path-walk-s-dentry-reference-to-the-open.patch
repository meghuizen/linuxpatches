From aa71a2122530a174b2f7c06383fd404f472dc5fb Mon Sep 17 00:00:00 2001
From: Michiel <367462+meghuizen@users.noreply.github.com>
Date: Sun, 20 Sep 2026 13:12:17 +0200
Subject: [PATCH] fs: hand the path walk's dentry reference to the opened file

Opening a file takes two references on the same dentry in quick
succession and drops one immediately. complete_walk() legitimises the
dentry to leave RCU mode, do_dentry_open() takes a second for f_path,
and terminate_walk() then drops the walk's. With the matching puts at
close(), one open/close cycle performs four atomic read-modify-writes on
that dentry's cacheline:

  complete_walk()  -> lockref_get_not_dead()
  do_dentry_open() -> lockref_get()
  terminate_walk() -> lockref_put_return()
  __fput()         -> lockref_put_return()

Two of them cancel each other out within microseconds. Hand the walk's
reference to the file instead, so the cycle performs two.

vfs_open_consume_dentry() is vfs_open() that takes over the caller's
reference on path->dentry rather than taking one of its own. The mount
reference is still taken, because do_open() goes on to use nd->path.mnt
for mnt_drop_write(). vfs_open() itself is unchanged for its five other
callers, and both stay internal to the VFS (fs/internal.h).

do_open() clears nd->path.dentry unconditionally, on success and on
failure: when the open fails, do_dentry_open() releases f_path itself,
so the transferred reference is gone either way and terminate_walk()
must not drop it again. Clearing only on success would double-put.

Nothing reads nd->path.dentry after this point: in do_open() the
remaining work is security_file_post_open(), handle_truncate() and
mnt_drop_write(), which use file or nd->path.mnt; in path_openat() the
only thing after do_open() is terminate_walk(), and path_put() tolerates
a NULL dentry (dput(NULL) returns immediately).

Measured on a profile of 12 processes opening and closing one shared
file, the dentry lockref operations are:

  lockref_put_return     2.00%
  lockref_get_not_dead   1.43%
  lockref_get            0.83%

so removing one get and one put halves the traffic on that line.

No functional change: this is an ownership transfer, not a relaxation of
any invariant.
---
 fs/internal.h |  1 +
 fs/namei.c    | 17 ++++++++++++--
 fs/open.c     | 61 ++++++++++++++++++++++++++++++++++++++++++---------
 3 files changed, 67 insertions(+), 12 deletions(-)

diff --git a/fs/internal.h b/fs/internal.h
index c658c8a5ebd5..438581c429f9 100644
--- a/fs/internal.h
+++ b/fs/internal.h
@@ -205,6 +205,7 @@ int do_fchownat(int dfd, const char __user *filename, uid_t user, gid_t group,
 		int flag);
 int chown_common(const struct path *path, uid_t user, gid_t group);
 extern int vfs_open(const struct path *, struct file *);
+extern int vfs_open_consume_dentry(const struct path *path, struct file *file);
 
 /*
  * inode.c
diff --git a/fs/namei.c b/fs/namei.c
index 20a6534ea3ef..69aba5e1a02e 100644
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -4833,8 +4833,21 @@ static int do_open(struct nameidata *nd,
 		do_truncate = true;
 	}
 	error = may_open(idmap, &nd->path, acc_mode, open_flag);
-	if (!error && !(file->f_mode & FMODE_OPENED))
-		error = vfs_open(&nd->path, file);
+	if (!error && !(file->f_mode & FMODE_OPENED)) {
+		/*
+		 * Hand the walk's reference on the dentry to the file instead
+		 * of having a second one taken and dropping ours a moment
+		 * later in terminate_walk(). Clear it here so that
+		 * terminate_walk() only releases the mount, which is still
+		 * ours: mnt_drop_write() below needs nd->path.mnt.
+		 *
+		 * This must happen whether the open succeeds or fails - on
+		 * failure do_dentry_open() releases f_path itself, so the
+		 * reference is gone either way.
+		 */
+		error = vfs_open_consume_dentry(&nd->path, file);
+		nd->path.dentry = NULL;
+	}
 	if (!error)
 		error = security_file_post_open(file, op->acc_mode);
 	if (!error && do_truncate)
diff --git a/fs/open.c b/fs/open.c
index 6b1c14e684a9..85076e4575be 100644
--- a/fs/open.c
+++ b/fs/open.c
@@ -931,14 +931,26 @@ static inline int file_get_write_access(struct file *f)
 	return error;
 }
 
+/*
+ * @consume_dentry: the caller is handing over its reference on
+ * f->f_path.dentry rather than expecting us to take one of our own. The
+ * mount reference is taken either way, since callers commonly keep using
+ * path->mnt after the open. On the error path f->f_path is path_put() as
+ * usual, which releases the handed-over reference, so the caller must not
+ * drop it again.
+ */
 static int do_dentry_open(struct file *f,
-			  int (*open)(struct inode *, struct file *))
+			  int (*open)(struct inode *, struct file *),
+			  bool consume_dentry)
 {
 	static const struct file_operations empty_fops = {};
 	struct inode *inode = f->f_path.dentry->d_inode;
 	int error;
 
-	path_get(&f->f_path);
+	if (consume_dentry)
+		mntget(f->f_path.mnt);
+	else
+		path_get(&f->f_path);
 	f->f_inode = inode;
 	f->f_mapping = inode->i_mapping;
 	f->f_wb_err = filemap_sample_wb_err(f->f_mapping);
@@ -1055,7 +1067,7 @@ int finish_open(struct file *file, struct dentry *dentry,
 	BUG_ON(file->f_mode & FMODE_OPENED); /* once it's opened, it's opened */
 
 	file->__f_path.dentry = dentry;
-	return do_dentry_open(file, open);
+	return do_dentry_open(file, open, false);
 }
 EXPORT_SYMBOL(finish_open);
 
@@ -1088,17 +1100,13 @@ char *file_path(struct file *filp, char *buf, int buflen)
 }
 EXPORT_SYMBOL(file_path);
 
-/**
- * vfs_open - open the file at the given path
- * @path: path to open
- * @file: newly allocated file with f_flag initialized
- */
-int vfs_open(const struct path *path, struct file *file)
+static int __vfs_open(const struct path *path, struct file *file,
+		      bool consume_dentry)
 {
 	int ret;
 
 	file->__f_path = *path;
-	ret = do_dentry_open(file, NULL);
+	ret = do_dentry_open(file, NULL, consume_dentry);
 	if (!ret) {
 		/*
 		 * Once we return a file with FMODE_OPENED, __fput() will call
@@ -1110,6 +1118,39 @@ int vfs_open(const struct path *path, struct file *file)
 	return ret;
 }
 
+/**
+ * vfs_open - open a path
+ * @path: path to open
+ * @file: newly allocated file with f_flag initialized
+ */
+int vfs_open(const struct path *path, struct file *file)
+{
+	return __vfs_open(path, file, false);
+}
+
+/**
+ * vfs_open_consume_dentry - open a path, taking over the dentry reference
+ * @path: path to open; the caller's reference on @path->dentry is consumed
+ * @file: newly allocated file with f_flag initialized
+ *
+ * Identical to vfs_open() except that the caller hands over its reference on
+ * @path->dentry instead of having a second one taken. The reference on
+ * @path->mnt is still taken, so the caller may keep using it; the caller must
+ * not use or release @path->dentry afterwards, on success or on failure.
+ *
+ * This exists because open() otherwise takes two references on the same
+ * dentry in quick succession and drops one immediately: the path walk
+ * legitimises the dentry to leave RCU mode, do_dentry_open() takes a second
+ * for f_path, and terminate_walk() then drops the walk's. On a file being
+ * opened concurrently by several CPUs those are two extra atomic
+ * read-modify-writes on one contended cacheline per open/close cycle, out of
+ * four in total.
+ */
+int vfs_open_consume_dentry(const struct path *path, struct file *file)
+{
+	return __vfs_open(path, file, true);
+}
+
 struct file *dentry_open(const struct path *path, int flags,
 			 const struct cred *cred)
 {
-- 
2.53.0

