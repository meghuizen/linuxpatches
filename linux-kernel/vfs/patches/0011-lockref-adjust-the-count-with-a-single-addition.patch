From 514137a8e4ea0bffc70b3287dff0644aee010164 Mon Sep 17 00:00:00 2001
From: Michiel <michieleghuizen@gmail.com>
Date: Sun, 20 Sep 2026 13:29:23 +0200
Subject: [PATCH 11/14] lockref: adjust the count with a single addition

The count shares a 64-bit word with the lock, and the cmpxchg loop already
operates on that word as a whole. Expressing the update as new.count++
makes the compiler treat the count as a separate int, so it extracts it
from the word, increments it and reassembles - six instructions on x86-64
where one addition suffices:

  before:                        after:
    mov    %rdx,%rcx               movabs $0x100000000,%rdx
    mov    %edx,%edx                add    %rax,%rdx
    sar    $0x20,%rcx
    add    $0x1,%ecx
    shl    $0x20,%rcx
    or     %rcx,%rdx
    lock cmpxchg %rdx,(%rdi)       lock cmpxchg %rdx,(%rdi)

Adding 1 << 32 to the word is exactly equivalent: there is no carry from
the lock half into the count half, and the loop only runs while the lock
is unlocked, so the lock bits are zero either way. The step is derived
from the struct layout through a union rather than hardcoded, so it stays
correct on big-endian, where the count occupies the other half.

Measured with a userspace model of the loop on a Zen 4 machine, one
shared cacheline, 20M operations per thread:

  threads   before        after         delta
        1   3.49 ns/op    2.23 ns/op    -36%
        4  17.25 ns/op   12.96 ns/op    -25%
        8  21.98 ns/op   16.90 ns/op    -23%

The gain survives contention because the shorter sequence also narrows
the window between the load and the cmpxchg, so fewer attempts lose the
cacheline and have to retry.

For why this path is worth changing: the dentry refcount helpers run
several times per path lookup - once per component to legitimise out of
RCU-walk, once more to take the reference on the result, and again on
release - so a workload that opens and closes files spends a visible
share of its kernel time in a function family of three.

No percentage is quoted here on purpose. The profile that first
motivated this patch was recorded on the machine's own kernel rather
than on the one being patched, which was not visible in its output; the
figures it produced (a sixth of kernel time, then 6.3%) describe a
different kernel with a different config and should not be attached to
this change. The argument for the patch does not need them: the
generated code is strictly shorter on every path, and shorter is not
conditional on a workload.

No functional change. The comparisons still read old.count; only the
update is expressed differently. sizeof(struct lockref) == 8 is already
asserted by the BUILD_BUG_ON in CMPXCHG_LOOP, and the block is compiled
only when USE_CMPXCHG_LOCKREF is set, which requires that layout.
---
 lib/lockref.c | 33 ++++++++++++++++++++++++++++-----
 1 file changed, 28 insertions(+), 5 deletions(-)

diff --git a/lib/lockref.c b/lib/lockref.c
index 9b3dd688d8cd..218ed1fc9655 100644
--- a/lib/lockref.c
+++ b/lib/lockref.c
@@ -4,6 +4,29 @@
 
 #if USE_CMPXCHG_LOCKREF
 
+/*
+ * The count shares its 64-bit word with the lock, so adjusting it is an
+ * addition to the word as a whole rather than a read-modify-write of one
+ * member. Writing it as new.count++ makes the compiler extract the count,
+ * increment it and reassemble the word - six instructions on x86-64:
+ *
+ *	mov %rdx,%rcx ; mov %edx,%edx ; sar $0x20,%rcx
+ *	add $0x1,%ecx ; shl $0x20,%rcx ; or %rcx,%rdx
+ *
+ * where one suffices. The step is derived from the layout instead of being
+ * hardcoded, so it remains correct whichever half of the word the count
+ * occupies on a given endianness.
+ */
+static __always_inline u64 lockref_step(void)
+{
+	const union {
+		struct lockref lr;
+		u64 v;
+	} one = { .lr = { .count = 1 } };
+
+	return one.v;
+}
+
 /*
  * Note that the "cmpxchg()" reloads the "old" value for the
  * failure case.
@@ -42,7 +65,7 @@
 void lockref_get(struct lockref *lockref)
 {
 	CMPXCHG_LOOP(
-		new.count++;
+		new.lock_count += lockref_step();
 	,
 		return;
 	);
@@ -63,7 +86,7 @@ bool lockref_get_not_zero(struct lockref *lockref)
 	bool retval = false;
 
 	CMPXCHG_LOOP(
-		new.count++;
+		new.lock_count += lockref_step();
 		if (old.count <= 0)
 			return false;
 	,
@@ -90,7 +113,7 @@ EXPORT_SYMBOL(lockref_get_not_zero);
 int lockref_put_return(struct lockref *lockref)
 {
 	CMPXCHG_LOOP(
-		new.count--;
+		new.lock_count -= lockref_step();
 		if (old.count <= 0)
 			return -1;
 	,
@@ -108,7 +131,7 @@ EXPORT_SYMBOL(lockref_put_return);
 bool lockref_put_or_lock(struct lockref *lockref)
 {
 	CMPXCHG_LOOP(
-		new.count--;
+		new.lock_count -= lockref_step();
 		if (old.count <= 1)
 			break;
 	,
@@ -145,7 +168,7 @@ bool lockref_get_not_dead(struct lockref *lockref)
 	bool retval = false;
 
 	CMPXCHG_LOOP(
-		new.count++;
+		new.lock_count += lockref_step();
 		if (old.count < 0)
 			return false;
 	,
